{
  "name": "intake-eval",
  "version": "0.3.0",
  "private": true,
  "description": "A small evaluation harness for human-reviewed AI support triage.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node src/cli.ts",
    "evaluate": "node src/cli.ts --json",
    "benchmark": "node src/benchmark-cli.ts",
    "build:web": "tsc -p tsconfig.web.json && node src/build-web.ts",
    "playground": "node src/serve.ts",
    "test:e2e": "playwright test",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run build:web && npm test && npm run evaluate"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
